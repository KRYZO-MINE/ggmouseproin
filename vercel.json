{
  "headers": [
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|webp|svg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/device-to-device-activation",
      "destination": "/device-by-device-activation",
      "permanent": true
    }
  ]
}
